# Python bytecode and tool caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Packaging and virtual environments
build/
dist/
*.egg-info/
.venv/
venv/

# Editors and OS files
.idea/
.vscode/
.DS_Store

# NOTE: data/ and reports/ are intentionally tracked: raw downloads under
# data/raw/, normalised snapshots under data/normalized/, the manifest, and
# the generated reports (latest.* and daily/).  Do not add them to this file.
